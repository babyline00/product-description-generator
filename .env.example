# Database (REQUIRED — must be an absolute path for SQLite)
DATABASE_URL="file:/home/z/my-project/apps/49-product-description-generator/db/custom.db"

# LLM provider (optional — if unset, the app falls back to a deterministic MockProvider)
# The z-ai-web-dev-sdk reads its own config from the environment.
# Set to "1" to force the MockProvider even if the SDK config is present (useful for offline tests).
PDG_DISABLE_LLM=

# Optional: max concurrency for batch generation (default 5)
PDG_BATCH_CONCURRENCY=5
